# Server only: required for durable production projects and contact messages.
# Leave blank only for NODE_ENV=development local-preview MongoDB.
MONGODB_URI=

# Server only: default owner is the VERIFIED Manus provider identity whose exact
# normalized email is ali.damghouni@gmail.com and whose openId matches the JWT.
# No first-visitor claim; request/JWT email, names, or role flags never grant access.
# Optional email override; blank or omitted retains the default above.
PORTFOLIO_OWNER_EMAIL=ali.damghouni@gmail.com

# Optional server-only pin to the owner's immutable authenticated Manus openId.
# When set, this exact id is authoritative instead of the email allowlist.
# Leave blank to use verified provider email; cron identities are never admins.
OWNER_OPEN_ID=

# Managed Manus environments supply the following authentication values.
# Do not expose MANUS_JWT_SECRET in any VITE_* variable.
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
# MANUS_OAUTH_PORTAL_URL=

# Optional development-only MongoDB binary version; default is 8.0.16.
# LOCAL_MONGO_VERSION=8.0.16

# PORT is provided by the managed runtime; use its configured port.
# PORT=3000
